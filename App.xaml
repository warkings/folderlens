<Application x:Class="FolderLens.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#0E1418" />
        <SolidColorBrush x:Key="PanelBrush" Color="#151E23" />
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#1A252B" />
        <SolidColorBrush x:Key="LineBrush" Color="#2B373D" />
        <SolidColorBrush x:Key="TextBrush" Color="#EEF4F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#91A09F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#66E4CF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#193F3C" />
        <SolidColorBrush x:Key="WarmBrush" Color="#FFB46A" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
