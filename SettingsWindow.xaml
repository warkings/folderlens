<Window x:Class="FolderLens.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración · FolderLens"
        Width="650"
        Height="510"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource InkBrush}">
    <Border Margin="10" Background="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="CONFIGURACIÓN" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,8,0,18">
                <TextBlock Text="¿Dónde querés buscar?" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="FolderLens solo revisará estas carpetas y todo lo que haya dentro." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="RootsList" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Button Content="＋  Agregar carpeta" Click="Add_Click" />
                    <Button Content="－  Quitar" Click="Remove_Click" Margin="0,9,0,0" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,20,0,0">
                <CheckBox x:Name="StartWithWindows" Content="Abrir FolderLens al iniciar Windows" Foreground="{StaticResource TextBrush}" FontSize="12" />
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="El buscador queda disponible desde el ícono junto al reloj." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Cancelar" Click="Cancel_Click" Margin="8,0,8,0" />
                    <Button Grid.Column="2" Content="Guardar cambios" Click="Save_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
