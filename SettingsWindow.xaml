<Window x:Class="FolderLens.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración · FolderLens"
        Width="650"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource InkBrush}">
    <Border Margin="10" Background="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SettingsEyebrow" Text="CONFIGURACIÓN" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,8,0,18">
                <TextBlock x:Name="SettingsHeading" Text="¿Dónde querés buscar?" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="SettingsDescription" Text="FolderLens solo revisará estas carpetas y todo lo que haya dentro." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="RootsList" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Button x:Name="AddFolderButton" Content="＋  Agregar carpeta" Click="Add_Click" />
                    <Button x:Name="RemoveFolderButton" Content="－  Quitar" Click="Remove_Click" Margin="0,9,0,0" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="3" Margin="0,18,0,0" Padding="15" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="HotkeyTitle" Text="Atajo para abrir" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="HotkeyHelpText" Text="Hacé clic en el atajo y presioná una combinación con Ctrl, Alt o Shift." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="HotkeyButton" Grid.Column="1" MinWidth="168" Height="42" Padding="16,8" Click="Hotkey_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown" LostKeyboardFocus="HotkeyButton_LostKeyboardFocus" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold" FocusVisualStyle="{x:Null}" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="HotkeyFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HotkeyFrame" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="HotkeyFrame" Property="Opacity" Value="0.72" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="HotkeyFrame" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="HotkeyFrame" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4" Margin="0,20,0,0">
                <CheckBox x:Name="StartWithWindows" Content="Abrir FolderLens al iniciar Windows" Foreground="{StaticResource TextBrush}" FontSize="12" />
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="LanguageStatusText" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                        <TextBlock x:Name="SettingsFooterText" Text="El buscador queda disponible desde el ícono junto al reloj." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Click="Cancel_Click" Margin="8,0,8,0" />
                    <Button x:Name="SaveButton" Grid.Column="2" Content="Guardar cambios" Click="Save_Click" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
