<Window x:Class="FolderLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderLens"
        SizeToContent="WidthAndHeight"
        MinWidth="780"
        Focusable="True"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Window.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.48" />
    </Window.Effect>
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" x:Name="MainShell" Width="780" VerticalAlignment="Top" Background="{StaticResource ShellBrush}" BorderBrush="#425A5A" BorderThickness="1" CornerRadius="24" ClipToBounds="True">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Margin="-14" CornerRadius="24" Background="{StaticResource ShellWarmGlowBrush}" IsHitTestVisible="False" />
            <Border Grid.RowSpan="2" Margin="-14" CornerRadius="24" Background="{StaticResource ShellMintGlowBrush}" IsHitTestVisible="False" />
            <Border Grid.Row="0" Height="72" Margin="4,7,4,0" Background="{StaticResource SearchBrush}" BorderBrush="#57716E" BorderThickness="1" CornerRadius="23">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="36" Background="{StaticResource AccentSoftBrush}" BorderBrush="#4A8D82" BorderThickness="1" CornerRadius="11" VerticalAlignment="Center">
                        <Path Data="M 4,9 L 10,9 L 13,12 L 28,12 L 30,14 L 30,27 L 4,27 Z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="26" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Grid Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="23" FontWeight="SemiBold" Padding="0" VerticalContentAlignment="Center" Focusable="True" IsTabStop="True" />
                        <TextBlock x:Name="SearchHint" Text="Buscar una carpeta…" Foreground="#607075" FontSize="23" FontWeight="SemiBold" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Grid.Column="2" Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="48" Height="48" Fill="{StaticResource LensGlowBrush}" />
                        <Ellipse Width="37" Height="37" Fill="#352A1A" Stroke="{StaticResource WarmBrush}" StrokeThickness="1.5" />
                        <Ellipse Width="18" Height="18" Stroke="#FFF4DA" StrokeThickness="2.4" />
                        <Line X1="30" Y1="30" X2="38" Y2="38" Stroke="#FFF4DA" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" x:Name="ResultsArea" Visibility="Collapsed" Margin="0,8,0,0" Background="{StaticResource GlassDeepBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="17" Padding="13">
                <Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ResultsListRow" Height="390" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,2,4,10" Visibility="Collapsed">
                            <TextBlock x:Name="ResultsHeaderText" Text="CARPETAS ENCONTRADAS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" />
                            <TextBlock x:Name="ResultCountText" Text="0 carpetas" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="ResultsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.Resources>
                                    <Style TargetType="{x:Type ScrollBar}">
                                        <Setter Property="Width" Value="8" />
                                        <Setter Property="Background" Value="#10191E" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                    <Grid Width="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                        <Track x:Name="PART_Track" Margin="1" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                                            <Border x:Name="ThumbFill" Background="#55726F" CornerRadius="4" />
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ThumbFill" Property="Background" Value="{StaticResource AccentBrush}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="12" Padding="13,11" MinHeight="62" MouseEnter="Folder_MouseEnter" MouseLeave="Folder_MouseLeave" MouseLeftButtonUp="Folder_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ResultBrush}" />
                                                    <Setter Property="BorderBrush" Value="#2B3B41" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#203A3A" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="31" Height="31" Background="{StaticResource AccentSoftBrush}" BorderBrush="#347B72" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                                                    <Path Data="M 4,9 L 10,9 L 13,12 L 27,12 L 29,14 L 29,26 L 4,26 Z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="20" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding LocationLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Ellipse Grid.Column="2" Width="10" Height="10" Fill="{StaticResource AccentBrush}" Opacity="0.72" VerticalAlignment="Center" Margin="10,0,5,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                                <TextBlock Text="⌕" Foreground="{StaticResource AccentBrush}" FontSize="34" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyTitle" Text="No encontramos esa carpeta" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock x:Name="EmptyMessage" Text="Probá con otra parte del nombre o ubicación." Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Border>
        <Border Grid.Column="1" x:Name="PreviewGap" Width="18" Background="Transparent" Visibility="Collapsed" />
        <Border Grid.Column="2" x:Name="PreviewPanel" Width="300" Visibility="Collapsed" VerticalAlignment="Top" Background="#E30C151A" BorderBrush="#536168" BorderThickness="1" CornerRadius="20" Padding="16">
            <Grid>
                <ItemsControl x:Name="PreviewThumbs" HorizontalContentAlignment="Center" VerticalContentAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="264" Height="113" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#10191E" BorderBrush="#3B4D54" BorderThickness="1" CornerRadius="12" Padding="2" ClipToBounds="True">
                                <Image Source="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PreviewTitle" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewPath" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewMessage" Visibility="Collapsed" />
                <Button x:Name="OpenPreviewButton" Visibility="Collapsed" Click="OpenPreview_Click" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
