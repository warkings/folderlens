<Window x:Class="FolderLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderLens"
        Width="840"
        SizeToContent="Height"
        MinWidth="720"
        Focusable="True"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Window.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.48" />
    </Window.Effect>
    <Border Margin="14" Background="{StaticResource InkBrush}" BorderBrush="#35474A" BorderThickness="1" CornerRadius="22">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="13" VerticalAlignment="Center" Margin="2,0,14,0">
                    <TextBlock Text="▰" Foreground="{StaticResource AccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="FOLDERLENS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="21" FontWeight="SemiBold" Padding="0" VerticalContentAlignment="Center" Focusable="True" IsTabStop="True" />
                        <TextBlock x:Name="SearchHint" Text="Buscar una carpeta…" Foreground="{StaticResource MutedBrush}" FontSize="21" FontWeight="SemiBold" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Alt + Espacio" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="⚙" ToolTip="Configuración" Click="Settings_Click" Width="36" Height="36" Padding="0" FontSize="16" BorderThickness="0" />
                    <Button Content="×" ToolTip="Cerrar" Click="CloseSearch_Click" Width="36" Height="36" Padding="0" FontSize="22" BorderThickness="0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" x:Name="ResultsArea" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.16*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.84*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="330" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,2,4,10">
                            <TextBlock Text="RESULTADOS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="ResultCountText" Text="0 carpetas" Foreground="{StaticResource AccentBrush}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="ResultsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="11" Padding="11,9" MouseEnter="Folder_MouseEnter" MouseLeftButtonUp="Folder_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#172127" />
                                                    <Setter Property="BorderBrush" Value="#26353B" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1D3435" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" Background="{StaticResource AccentSoftBrush}" CornerRadius="9" VerticalAlignment="Center">
                                                    <TextBlock Text="▰" Foreground="{StaticResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding LocationLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="22" VerticalAlignment="Center" Margin="8,0,3,2" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                                <TextBlock Text="⌕" Foreground="{StaticResource AccentBrush}" FontSize="34" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyTitle" Text="No encontramos esa carpeta" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock x:Name="EmptyMessage" Text="Probá con otra parte del nombre o ubicación." Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="2" x:Name="PreviewPanel" Background="#111B20" BorderBrush="#26383C" BorderThickness="1" CornerRadius="13" Padding="13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="VISTA PREVIA" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Margin="0,9,0,0">
                                <TextBlock x:Name="PreviewTitle" Text="Elegí una carpeta" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PreviewPath" Text="Las fotos aparecen acá" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="0,15,0,12">
                                <ItemsControl x:Name="PreviewThumbs">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="86" Height="102" Background="{StaticResource PanelSoftBrush}" BorderBrush="#2B3A3F" BorderThickness="1" CornerRadius="8" Margin="0,0,7,7" Padding="3">
                                                <Grid>
                                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                    <Border Background="#C50E1418" VerticalAlignment="Bottom" Padding="3,2">
                                                        <TextBlock Text="{Binding FileName}" FontSize="8" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="PreviewMessage" Text="Pasá el mouse por una carpeta" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            <Button Grid.Row="3" x:Name="OpenPreviewButton" Content="Abrir carpeta  →" Click="OpenPreview_Click" HorizontalAlignment="Left" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" IsEnabled="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
